# AI Provider: openai | gemini | mock
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=45

# OpenAI (only needed if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Gemini (only needed if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database URL (SQLite for dev, PostgreSQL for prod)
# Local SQLite example:
# DATABASE_URL=sqlite:///./grant_assistant.db
# Docker/PostgreSQL example:
DATABASE_URL=postgresql+asyncpg://grant_assistant:change-me@postgres:5432/grant_assistant

# PostgreSQL container defaults used by docker-compose.yml
POSTGRES_DB=grant_assistant
POSTGRES_USER=grant_assistant
POSTGRES_PASSWORD=change-me

# Upload settings
MAX_UPLOAD_MB=10

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
